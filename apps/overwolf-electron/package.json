{
  "name": "@dota-flow/overwolf-electron",
  "version": "0.23.4",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "productName": "Dota Flow",
  "author": {
    "name": "Yander Production"
  },
  "scripts": {
    "dev": "npm run build && npm run start",
    "start": "ow-electron . --remote-debugging-port=9222 --owepm-packages-url=https://electronapi-qa.overwolf.com/v2/packages",
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.json && node scripts/finalize-build.mjs",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "build:ow-electron": "ow-electron-builder --publish=never"
  },
  "overwolf": {
    "packages": [
      "gep",
      "overlay"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@overwolf/ow-electron": "39.8.12",
    "@overwolf/ow-electron-builder": "26.9.0",
    "@overwolf/ow-electron-packages-types": "1.1.5-2",
    "@types/node": "22.0.0",
    "electron": "37.10.3",
    "typescript": "5.8.2"
  }
}
